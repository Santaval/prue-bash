SUPABASE_URL=
SUPABASE_KEY=
MODELS_DIR=apps/trainer/dist
API_SKIP_MODEL_LOADING=false
API_MODELS=diabetes
# For local testing use postgres; switch to supabase for the hosted backend.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://prue:local_only_password@localhost:54329/prue
POSTGRES_USER=prue
POSTGRES_PASSWORD=local_only_password
POSTGRES_DB=prue
# Comma-separated browser origins allowed to call the API (the UI).
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
